{
  "name": "urbanflow-mobility",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tsc -b && bun scripts/build.ts",
    "start": "NODE_ENV=production bun server/src/index.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p server",
    "test": "bun test src server ./scripts/bus-import.test.ts",
    "e2e": "bun scripts/e2e-planning.mjs",
    "e2e:transport": "bun scripts/e2e-transport-map.mjs",
    "e2e:offline": "bun scripts/e2e-offline.mjs",
    "e2e:trips": "bun scripts/e2e-trip-history.mjs",
    "audit:a11y": "bun scripts/audit-a11y.mjs",
    "bench:perf": "bun scripts/perf-bench.mjs",
    "metrics:build": "bun scripts/build-metrics.mjs",
    "screens": "bun scripts/make-screens.mjs",
    "seed:demo": "bun server/src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "generate:gtfs": "python3 scripts/fetch_gtfs.py",
    "generate:lignes": "python3 scripts/fetch_tcl_lines.py && python3 scripts/fetch_tcl_bus.py",
    "generate:icons": ".venv/bin/python scripts/generate_icons.py",
    "generate:pdf": "bun scripts/build-metrics.mjs && .venv/bin/python scripts/generate_dossier.py",
    "seed:test": "bun server/src/seed-test.ts",
    "e2e:evolution": "bun scripts/e2e-evolution.mjs",
    "test:docker:seed": "bun scripts/test-docker-seed.ts",
    "generate:bus": "python3 scripts/fetch_tcl_bus.py",
    "ci": "bun scripts/ci.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@elysiajs/openapi": "^1.4.15",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "jotai": "^2.20.3",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.30.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axe-core": "^4.12.1",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright-core": "^1.61.1",
    "typescript": "^7.0.2"
  }
}
