{
  "name": "urbanflow-mobility",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "bun --watch server/src/index.ts",
    "start:api": "NODE_ENV=production bun server/src/index.ts",
    "seed:demo": "bun server/src/seed.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p server",
    "test": "vitest run",
    "test:api": "bun test server",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:api && npm run build",
    "e2e": "node scripts/e2e-planning.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "bench:perf": "node scripts/perf-bench.mjs",
    "metrics:build": "node scripts/build-metrics.mjs",
    "screens": "node scripts/make-screens.mjs",
    "generate:gtfs": "python3 scripts/fetch_gtfs.py",
    "generate:icons": ".venv/bin/python scripts/generate_icons.py",
    "generate:pdf": "node scripts/build-metrics.mjs && .venv/bin/python scripts/generate_dossier.py"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.29",
    "fastify": "^5.12.1",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
