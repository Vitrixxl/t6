node_modules/
dist/
.venv/
tmp/
.DS_Store
npm-debug.log*
tsconfig.tsbuildinfo
# captures intermediaires de sessions de travail (les finales sont dans output/screens/)
# Le dossier de sortie n'est pas versionne : captures, metriques et rendus
# intermediaires sont regeneres par script (AGENTS.md). Seul le diaporama
# d'oral output/presentation/ l'est, sans ses dependances.
output/*
!output/presentation/
output/presentation/node_modules/
output/*.png
# secrets locaux (jeton GTFS) — .env.example est versionne, .env non
.env
scripts/__pycache__/
# metriques regenerees par npm run metrics:build (lues par generate:pdf)
output/metrics/
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.gif
output/**/*.webp


# base SQLite locale du serveur (donnees de comptes, jamais versionnees)
server/data/

# lockfile unique du projet : bun.lock (npm/pnpm/yarn ne sont pas utilises)
package-lock.json
pnpm-lock.yaml
yarn.lock

# Certificats TLS : une cle privee ne se versionne jamais.
*.pem

# Worktrees git crees par les sessions d agents : d autres branches, jamais ce depot.
.claude/worktrees/

# Extraits OSM et index OSRM préparés localement.
infra/osrm-data/
