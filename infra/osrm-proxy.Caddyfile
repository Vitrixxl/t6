# Facade des deux profils OSRM sur un seul port.
#
# Le service porte le nom `osrm` dans le compose : l'API n'a donc qu'une seule
# adresse a connaitre, `http://osrm:5000`, quelle que soit le mode demande.
#
# OSRM sert un profil par processus. Sans cette facade il faudrait deux URL
# dans la configuration, et l'application distinguerait une instance locale
# d'une instance publique. Ici les chemins reproduisent exactement ceux de
# l'instance publique : basculer de l'une a l'autre ne change qu'une URL.
:5000 {
	handle_path /routed-foot/* {
		reverse_proxy osrm-foot:5000
	}
	handle_path /routed-bike/* {
		reverse_proxy osrm-bike:5000
	}
	respond "OSRM local : /routed-foot, /routed-bike" 404
}
