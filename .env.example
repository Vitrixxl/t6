# Source du GTFS statique TCL (SYTRAL, licence ODbL), referencee sur transport.data.gouv.fr.
# L'URL contient un jeton d'acces: c'est un SECRET, ne jamais le committer.
# Copier ce fichier en .env, renseigner la valeur, puis: npm run generate:gtfs
# Le feed public/data/gtfs-feed.json est deja versionne: cette variable ne sert
# qu'a le regenerer depuis la source officielle.
GTFS_SOURCE_URL=

# Compte data.grandlyon.com (gratuit) pour les alertes trafic TCL temps reel
# (SIRI Situation Exchange). SECRETS, ne jamais les committer.
# Sans ces identifiants, l'application retombe sur les incidents simules.
GRANDLYON_LOGIN=
GRANDLYON_PASSWORD=

# --- API UrbanFlow (server/) ---
# Port et adresse d'ecoute de l'API. Le serveur de developpement Vite relaie
# /api vers cette cible : le navigateur ne voit qu'une seule origine.
API_PORT=4000
API_HOST=127.0.0.1
# Emplacement de la base SQLite. Elle contient des donnees personnelles
# (comptes, trajets) : jamais versionnee, jamais dans un dossier public.
DATABASE_PATH=server/data/urbanflow.db
# Duree de vie d'une session (7 jours par defaut, en millisecondes).
SESSION_TTL_MS=604800000
# Mettre a true uniquement derriere un proxy de confiance qui reecrit
# X-Forwarded-For (sinon un client peut usurper son adresse IP).
TRUST_PROXY=false

# --- Calcul d'itineraires ---
# Base du service OSRM. Vide = instance publique de demonstration
# d'OpenStreetMap : elle depanne, mais elle n'a aucun engagement de service et
# limite par adresse IP. Pour une instance locale (voir README) :
#   OSRM_BASE_URL=http://127.0.0.1:5000
OSRM_BASE_URL=
# Duree de conservation d'un trace en cache, en millisecondes (defaut 24 h).
ROUTE_CACHE_TTL_MS=
