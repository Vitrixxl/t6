# Source du GTFS statique TCL (SYTRAL, licence ODbL), référencée sur transport.data.gouv.fr.
# L'URL contient un jeton d'accès: c'est un SECRET, ne jamais le committer.
# Copier ce fichier en .env, renseigner la valeur, puis : bun run generate:gtfs
# Le feed public/data/gtfs-feed.json est déjà versionné : cette variable ne sert
# qu'à le régénérer depuis la source officielle.
GTFS_SOURCE_URL=

# --- API UrbanFlow (server/) ---
# Port et adresse d'écoute du serveur qui sert le client et l'API :
# le navigateur ne voit qu'une seule origine.
API_PORT=4000
API_HOST=127.0.0.1
# Emplacement de la base SQLite. Elle contient des données personnelles
# (comptes, trajets) : jamais versionnée, jamais dans un dossier public.
DATABASE_PATH=server/data/urbanflow.db
# Durée de vie d'une session (7 jours par défaut, en millisecondes).
SESSION_TTL_MS=604800000
# Mettre à true uniquement derrière un proxy de confiance qui réécrit
# X-Forwarded-For (sinon un client peut usurper son adresse IP).
TRUST_PROXY=false

# --- Calcul d'itinéraires ---
# Une URL par profil. Absente ou vide = instance publique pour ce profil,
# sans engagement de service et avec limitation par IP. Le préfixe public
# /routed-foot, /routed-bike ou /routed-car fait partie de l'URL.
# Docker configure les adresses internes ; hors conteneur, voir README.
OSRM_FOOT_URL=
OSRM_BIKE_URL=
OSRM_CAR_URL=
# Durée de conservation d'un tracé en cache, en millisecondes (défaut 24 h).
ROUTE_CACHE_TTL_MS=
