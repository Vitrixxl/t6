# Archive officielle TCL : accès Data Grand Lyon (licence Mobilité).
# Créer le compte puis définir le mot de passe Data :
# https://rdata-grandlyon.readthedocs.io/fr/latest/authentification.html
# Identifiants privés : .env n’est jamais committé.
# Activer après import d’une archive officielle actuelle. Un ZIP local suffit.
MOTIS_TRANSIT_ENABLED=false
GTFS_SOURCE_FILE=''
GTFS_SOURCE_URL=''
# Facultatif : dossier absolu du graphe à préparer et à monter dans Compose.
MOTIS_DATA_DIR=''
GTFS_USERNAME=''
GTFS_PASSWORD=''
# Le réseau normalisé data/transport/gtfs-feed.json est déjà versionné.
# Ces réglages servent à ./infra/motis-prepare.sh et à bun run generate:gtfs.

# --- API UrbanFlow (server/) ---
# Port et adresse d'écoute du serveur qui sert le client et l'API :
# le navigateur ne voit qu'une seule origine.
API_PORT=4000
API_HOST=127.0.0.1
# Emplacement de la base SQLite. Elle contient des données personnelles
# (comptes, trajets) : jamais versionnée, jamais dans un dossier public.
DATABASE_PATH=server/data/urbanflow.db
# Durée de vie d'une session (7 jours par défaut, en millisecondes).
SESSION_TTL_MS=604800000
# Mettre à true uniquement derrière un proxy de confiance qui réécrit
# X-Forwarded-For (sinon un client peut usurper son adresse IP).
TRUST_PROXY=false

# --- Calcul d'itinéraires ---
# Adresse du moteur MOTIS. Absente ou vide = service Docker motis:8080.
# Hors conteneur : http://127.0.0.1:8080 (voir README).
MOTIS_URL=
