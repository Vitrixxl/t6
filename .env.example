# Source du GTFS statique TCL (SYTRAL, licence ODbL), référencée sur transport.data.gouv.fr.
# L'URL contient un jeton d'accès: c'est un SECRET, ne jamais le committer.
# Copier ce fichier en .env, renseigner la valeur, puis: npm run generate:gtfs
# Le feed public/data/gtfs-feed.json est déjà versionne: cette variable ne sert
# qu'a le régénérer depuis la source officielle.
GTFS_SOURCE_URL=

# --- API UrbanFlow (server/) ---
# Port et adresse d'écoute de l'API. Le serveur de développement Vite relaie
# /api vers cette cible : le navigateur ne voit qu'une seule origine.
API_PORT=4000
API_HOST=127.0.0.1
# Emplacement de la base SQLite. Elle contient des données personnelles
# (comptes, trajets) : jamais versionnée, jamais dans un dossier public.
DATABASE_PATH=server/data/urbanflow.db
# Durée de vie d'une session (7 jours par défaut, en millisecondes).
SESSION_TTL_MS=604800000
# Mettre a true uniquement derrière un proxy de confiance qui réécrit
# X-Forwarded-For (sinon un client peut usurper son adresse IP).
TRUST_PROXY=false

# --- Calcul d'itinéraires ---
# Base du service OSRM. Vide = instance publique de démonstration
# d'OpenStreetMap : elle dépanne, mais elle n'a aucun engagement de service et
# limite par adresse IP. Pour une instance locale (voir README) :
#   OSRM_BASE_URL=http://127.0.0.1:5000
OSRM_BASE_URL=
# Durée de conservation d'un tracé en cache, en millisecondes (défaut 24 h).
ROUTE_CACHE_TTL_MS=
