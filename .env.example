# Réglages facultatifs : docker compose up démarre sans ce fichier.
# Copier en .env (jamais committé) pour surcharger ce qui suit.

# --- Horaires TCL dans le moteur d'itinéraires ---
# true  : l'archive versionnée infra/gtfs/tcl.gtfs.zip est importée.
# false : marche, vélo, voiture et engins partagés seulement, avec bandeau.
MOTIS_TRANSIT_ENABLED=true

# --- Application ---
# Port HTTPS publié par Compose (443 = https://mon-nom sans préciser de port).
HTTPS_PORT=443
# Mot de passe du compte de recette (test@urbanflow.local).
TEST_PASSWORD='UrbanFlow2026!'
# Adresses supplémentaires inscrites dans le certificat auto-signé, lu à sa
# génération au premier démarrage : nom public de l'instance, IP du réseau
# local pour un téléphone. Exemple : DNS:mon-nom.duckdns.org,IP:192.168.1.37
TLS_EXTRA_HOSTS=''

# --- Serveur lancé hors conteneur (bun run dev, bun run start) ---
API_PORT=4000
API_HOST=127.0.0.1
# Emplacement de la base SQLite. Elle contient des données personnelles
# (comptes, trajets) : jamais versionnée, jamais dans un dossier public.
DATABASE_PATH=server/data/urbanflow.db
# Durée de vie d'une session (7 jours par défaut, en millisecondes).
SESSION_TTL_MS=604800000
# Mettre à true uniquement derrière un proxy de confiance qui réécrit
# X-Forwarded-For (sinon un client peut usurper son adresse IP).
TRUST_PROXY=false
# Accès Data Grand Lyon (licence Mobilité, compte gratuit) pour
# bun run generate:gtfs et le renouvellement de infra/gtfs/tcl.gtfs.zip :
# https://rdata-grandlyon.readthedocs.io/fr/latest/authentification.html
GTFS_SOURCE_URL=''
GTFS_USERNAME=''
GTFS_PASSWORD=''
# Adresse du moteur MOTIS. Absente ou vide = service Docker motis:8080.
# Hors conteneur : http://127.0.0.1:8080 une fois le port publié (voir README).
MOTIS_URL=
